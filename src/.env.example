# Application configuration
# Copy to .env and fill in values before running.

# ── Application ─────────────────────────────────────────────────────
APP_NAME=meeting-transcript-analyzer
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── LLM Provider (AI Hub: qwen-3.6-35b-sovereign) ──────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=anthropic/qwen-3.6-35b-sovereign
LLM_API_KEY=<your-ai-hub-api-key>
LLM_API_BASE=https://adesso-ai-hub.3asabc.de

# Max completion tokens per call. Qwen 3.6 is a reasoning model and its
# hidden thinking tokens count against this budget, so a ceiling sized for
# the visible answer alone truncates the JSON mid-document.
LLM_MAX_TOKENS=8000

# ── Fallback provider: local Claude Code CLI ────────────────────────
# Set LLM_PROVIDER=claude_cli to run the analysis through an already
# authenticated `claude -p` process instead of an HTTP provider. Useful
# when the AI Hub is unreachable, over budget, or you have no API key.
#
# LOCAL DEVELOPMENT ONLY. Two things this is not:
#   1. Not deployable. The CLI authenticates against the desktop
#      keychain; a container and CI have neither, so do not put this in
#      the Dockerfile or .gitlab-ci.yml.
#   2. Not sovereign. Transcripts go to the Anthropic API rather than
#      staying on the internal hub. Transcripts are internal-only data
#      (NFR-S-001) -- get sign-off before using this on real meetings.
#
# It does not retry: a CLI failure is deterministic, so a second
# identical invocation only spends the timeout again.
#
# LLM_PROVIDER=claude_cli
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=claude-haiku-4-5-20251001
# Each invocation is a whole Node process, so keep this low.
CLAUDE_CLI_MAX_CONCURRENCY=2

# ── Upload constraints ──────────────────────────────────────────────
MAX_TRANSCRIPT_PAGES=50
MAX_FILE_SIZE_BYTES=5242880

# ── Performance (NFR-P-001) ─────────────────────────────────────────
# A 30-page transcript measures ~83s; 50 pages needs the headroom.
TRANSCRIPT_TIMEOUT=300
